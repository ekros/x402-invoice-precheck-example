# Copy to .env (never commit .env). Without PRIVATE_KEY the scripts only fetch the free price quote.
#
# Private key of a DEDICATED, low-balance hot wallet on Base mainnet holding a few USDC.
# Do NOT use your main wallet. Each single check costs 0.03 USDC; a batch costs 0.01 USDC per invoice.
PRIVATE_KEY=0x...

# Hard cap per HTTP call, in USD. The client refuses to sign anything above this.
MAX_USD_PER_CALL=0.03

# Optional: override the API base URL.
# API_BASE=https://spain-agent-toolkit.spain-agent-toolkit.workers.dev
